<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="graphicspractica.DatosCarro.Datos">
  <grid id="27dc6" binding="PanelInfo" layout-manager="BorderLayout" hgap="0" vgap="0">
    <constraints>
      <xy x="20" y="20" width="500" height="400"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <component id="8daa8" class="javax.swing.JButton" binding="BtnCerrar">
        <constraints border-constraint="South"/>
        <properties>
          <text value="Cerrar"/>
        </properties>
      </component>
      <component id="7e1f3" class="javax.swing.JLabel">
        <constraints border-constraint="West"/>
        <properties>
          <text value="Datos del carro"/>
        </properties>
      </component>
    </children>
  </grid>
</form>
