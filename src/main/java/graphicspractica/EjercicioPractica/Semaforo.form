<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="graphicspractica.EjercicioPractica.Semaforo">
  <grid id="27dc6" binding="PanelPrincipal" layout-manager="BorderLayout" hgap="0" vgap="0">
    <constraints>
      <xy x="20" y="20" width="902" height="455"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <grid id="29eec" binding="PanelSemaforo" custom-create="true" layout-manager="BorderLayout" hgap="0" vgap="0">
        <constraints border-constraint="West"/>
        <properties/>
        <border type="none"/>
        <children/>
      </grid>
      <grid id="c50f7" binding="PanelBotones" layout-manager="BorderLayout" hgap="0" vgap="0">
        <constraints border-constraint="South"/>
        <properties/>
        <border type="none"/>
        <children>
          <component id="e897b" class="javax.swing.JButton" binding="BtnIniciar">
            <constraints border-constraint="West"/>
            <properties>
              <text value="Iniciar"/>
            </properties>
          </component>
          <component id="99b17" class="javax.swing.JButton" binding="BtnDetener">
            <constraints border-constraint="Center"/>
            <properties>
              <text value="Detener"/>
            </properties>
          </component>
          <component id="6a6c2" class="javax.swing.JButton" binding="BtnInfo">
            <constraints border-constraint="East"/>
            <properties>
              <text value="Info"/>
            </properties>
          </component>
        </children>
      </grid>
    </children>
  </grid>
</form>
