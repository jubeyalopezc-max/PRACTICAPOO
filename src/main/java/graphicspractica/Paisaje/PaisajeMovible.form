<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="graphicspractica.Paisaje.PaisajeMovible">
  <grid id="27dc6" binding="PanelPrincipal" layout-manager="BorderLayout" hgap="0" vgap="0">
    <constraints>
      <xy x="20" y="20" width="1046" height="577"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <grid id="cb623" binding="panelPaisaje" custom-create="true" layout-manager="BorderLayout" hgap="0" vgap="0">
        <constraints border-constraint="North"/>
        <properties/>
        <border type="none"/>
        <children/>
      </grid>
      <grid id="d4ab9" binding="PanelBotones" layout-manager="BorderLayout" hgap="0" vgap="0">
        <constraints border-constraint="South"/>
        <properties/>
        <border type="none"/>
        <children>
          <component id="efc7c" class="javax.swing.JButton" binding="BtnIniciar">
            <constraints border-constraint="West"/>
            <properties>
              <text value="Iniciar"/>
            </properties>
          </component>
          <component id="e4094" class="javax.swing.JButton" binding="BtnDetener">
            <constraints border-constraint="Center"/>
            <properties>
              <text value="Detener"/>
            </properties>
          </component>
        </children>
      </grid>
    </children>
  </grid>
</form>
